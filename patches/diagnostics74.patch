+                for(String k:observed.keySet())if(!registry.has(k))extra++;
+                out.append("Registry missing/mismatched/extra string keys: ").append(missing).append('/').append(mismatch).append('/').append(extra).append("; non-registry keys: ").append(client).append('\n');
+            }catch(Exception|LinkageError e){out.append("Registry structure: not verified ("+errorSummary(e)+")\n");}
+        } catch(Exception | LinkageError e){out.append("Inventory stopped: ").append(errorSummary(e)).append('\n');}
+        return out.toString();
+    }
+    static String exitReasonName(int reason) {
+        switch(reason) {
+            case 1: return "self exit";
+            case 2: return "signal";
+            case 3: return "low memory";
+            case 4: return "Java crash";
+            case 5: return "native crash";
+            case 6: return "ANR";
+            case 7: return "initialization failure";
+            case 8: return "permission change";
+            case 9: return "excess resource use";
+            case 10: return "user requested";
+            case 11: return "user stopped";
+            case 12: return "dependency died";
+            default: return "other/unknown";
+        }
+    }
+    private static String recentExits(Context c) {
+        if (android.os.Build.VERSION.SDK_INT<30) return "Historical process exits unavailable on this Android version.\n";
+        try {
+            android.app.ActivityManager am=(android.app.ActivityManager)c.getSystemService(Context.ACTIVITY_SERVICE);
+            if(am==null)return "Historical process exit service unavailable.\n";
+            StringBuilder out=new StringBuilder("Recent process exits (system history, may include earlier builds)\n");
+            for(android.app.ApplicationExitInfo e:am.getHistoricalProcessExitReasons(c.getPackageName(),0,5)) {
+                out.append(e.getTimestamp()).append(" reason=").append(e.getReason()).append(" (").append(exitReasonName(e.getReason()))
+                    .append(") status=").append(e.getStatus()).append('\n');
+            }
+            return out.toString();
+        }catch(Exception|LinkageError e){return "Historical process exits unavailable: "+errorSummary(e)+"\n";}
+    }
+    static String report(Context c) {
+        StringBuilder out=new StringBuilder("FFBE-Custom mobile startup report\nInstalled versionCode: ").append(version(c))
+            .append("\nAndroid API: ").append(android.os.Build.VERSION.SDK_INT).append('\n');
+        try { out.append("Native page size: ").append(Os.sysconf(OsConstants._SC_PAGESIZE)).append('\n'); }
+        catch(Exception|LinkageError e){out.append("Native page size: unavailable\n");}
+        synchronized(DataUpdates.class) {
+            if(NativeStartupTrial.claimed())out.append("Profile inspection deferred: this process has reserved a startup trial.\n");
+            else out.append(profileInventory(c)).append(NativeStartupTrial.freshProfileDiagnostic(c)).append('\n');
+        }
+        out.append("\n").append(recentExits(c));
+        return out.append("\nPersistent startup events (Java phase markers only; native crash dumps not collected)\n").append(history(c)).toString();
+    }
+}
