+            if (i>0) out.append(" > ");
+            out.append(safeToken(error.getClass().getSimpleName()));
+            String m=error.getMessage();
+            if (m==null) continue;
+            if (m.contains("dlopen failed")) out.append(" [native loader]");
+            if (m.contains("No module named")) out.append(" [Python module missing]");
+            if (m.contains("Permission denied") || m.contains("EACCES")) out.append(" [permission denied]");
+            if (m.contains("No space left") || m.contains("ENOSPC")) out.append(" [storage full]");
+            if (m.contains("UnsatisfiedLinkError")) out.append(" [native link]");
+        }
+        return out.toString();
+    }
+    private static void checkRegular(File f, int max) throws Exception {
+        if (!LocalArchiveIntake.exists(f)) return;
