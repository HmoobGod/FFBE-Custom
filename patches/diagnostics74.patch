+        if (!LocalArchiveIntake.exists(dir)) Os.mkdir(dir.getPath(),0700);
+        LocalArchiveIntake.directory(dir);
+        File file=new File(dir,"startup.txt");
+        for (String suffix:new String[]{"", ".bak", ".new"}) checkRegular(new File(file.getPath()+suffix),LIMIT);
+        return new AtomicFile(file);
+    }
