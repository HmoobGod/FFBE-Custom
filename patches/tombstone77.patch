+package com.exvius.local;
+
+import java.io.*;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+
+/** AOSP debuggerd tombstone.proto. Bounded, read-only; never emits raw messages or memory. */
+final class TombstoneSummaryReader {
+    static final int LIMIT = 2 * 1024 * 1024;
+    private TombstoneSummaryReader() {}
+    private static IOException invalid() { return new IOException("Invalid or oversized native trace"); }
+    private static final class Wire {
+        final byte[] b; int p; final int end;
+        Wire(byte[] b,int p,int end) { this.b=b; this.p=p; this.end=end; }
+        boolean more() { return p<end; }
+        long varint() throws IOException {
+            long v=0;
+            for(int i=0;i<10;i++) { if(p>=end)throw invalid(); int x=b[p++]&255;
+                if(i==9&&(x&254)!=0)throw invalid(); v|=(long)(x&127)<<(7*i); if((x&128)==0)return v; }
+            throw invalid();
+        }
+        int tag() throws IOException { long t=varint(); if(t<=0||t>0xffffffffL||(t>>>3)==0)throw invalid(); return (int)t; }
+        void advance(int n)throws IOException { if(n<0||n>end-p)throw invalid();p+=n; }
+        Wire message()throws IOException {long n=varint();if(n<0||n>end-p)throw invalid();int start=p;advance((int)n);return new Wire(b,start,p);}
+        String string()throws IOException {Wire w=message(); return new String(b,w.p,Math.min(w.end-w.p,4096),StandardCharsets.UTF_8);}
+        void skip(int t)throws IOException {switch(t&7){case 0:varint();break;case 1:advance(8);break;case 2:message();break;case 5:advance(4);break;default:throw invalid();}}
+    }
+    static String category(String raw) {
+        String s=raw.toLowerCase(Locale.ROOT); List<String> a=new ArrayList<>();
+        if(s.contains("jni detected error")||s.contains("invalid jni"))a.add("JNI validation");
+        if(s.contains("transition frame"))a.add("JNI transition frame");
+        if(s.contains("no implementation found")||s.contains("nosuchmethod")||s.contains("no such method"))a.add("JNI method resolution");
+        if(s.contains("nosuchfield")||s.contains("no such field"))a.add("JNI field resolution");
+        if(s.contains("frida")||s.contains("gadget"))a.add("Frida/Gadget marker");
+        if(s.contains("scudo"))a.add("Scudo allocator");
+        if(s.contains("fdsan"))a.add("file descriptor sanitizer");
+        if(s.contains("std::terminate")||s.contains("terminating with uncaught exception"))a.add("C++ termination");
+        if(s.contains("dlopen")||s.contains("cannot locate symbol")||s.contains("library not found"))a.add("native loader");
+        if(s.contains("permission denied")||s.contains("eacces"))a.add("permission denied");
+        if(s.contains("assertion")||s.contains("assert failed"))a.add("assertion");
+        if(s.contains("use-after-free")||s.contains("use after free"))a.add("use after free");
+        if(s.contains("double free"))a.add("double free");
+        if(s.contains("null pointer"))a.add("null pointer");
+        if(s.contains("python")||s.contains("chaquopy"))a.add("Python marker");
+        return a.isEmpty()?"unclassified (raw text withheld)":String.join(", ",a);
+    }
+    // Only well-known native modules; offsets retained for symbolication. Unknown names are redacted.
+    private static String module(String s) {
+        String n=s.substring(s.lastIndexOf('/')+1);
+        if(n.startsWith("_cffi_backend") && n.endsWith(".so")) return "_cffi_backend.so";
+        if(n.startsWith("_rust") && n.endsWith(".so")) return "_rust.so";
+        if(n.matches("(?:lib(?:game|exviustest(?:\\.js)?|frida-gadget|art(?:d)?|c|dl|m|log|c\\+\\+_shared|c\\+\\+|android|nativehelper|base|utils|unwindstack|binder|EGL|GLESv[123](?:_CM)?|OpenSLES|audioclient|python[0-9.]*|chaquopy_java|ffi|curl|ssl|crypto|z|cocos2d(?:x)?|hwui)|_cffi_backend(?:\\.[A-Za-z0-9_-]+)*|_rust(?:\\.[A-Za-z0-9_-]+)*)\\.so")||n.equals("linker64")||n.equals("linker"))return n;
+        return "other module";
+    }
+    private static String symbol(String s) {
+        if(s.equals("abort")||s.equals("tgkill")||s.equals("__assert2")||s.equals("JNI_OnLoad")||s.equals("nativeInit"))return s;
+        // Fixed classification, not untrusted function strings.
+        String l=s.toLowerCase(Locale.ROOT);
+        for(String k:new String[]{"jni_onload","nativeinit","checkjni","jniabort","decodegcmask","markcompact","frida","gadget","scudo","fdsan","terminate","dlopen","pyinitialize","py_initialize","cocos2d"})if(l.contains(k))return k;
+        return "symbol withheld";
+    }
+    private static String signal(Wire w)throws IOException {int n=0,c=0;while(w.more()){int t=w.tag();if(t==8)n=(int)w.varint();else if(t==24)c=(int)w.varint();else w.skip(t);}return "Signal: "+n+(n==6?" (SIGABRT)":n==11?" (SIGSEGV)":"")+" code="+c;}
+    private static String frame(Wire w)throws IOException {long pc=0,off=0;String m="",s="";while(w.more()){int t=w.tag();switch(t){case 8:pc=w.varint();break;case 34:s=w.string();break;case 40:off=w.varint();break;case 50:m=w.string();break;default:w.skip(t);}}
+        return module(m)+" rel_pc=0x"+Long.toHexString(pc)+" "+symbol(s)+" +0x"+Long.toHexString(off);}
+    private static String thread(Wire w,long wanted)throws IOException {long id=0;List<String> frames=new ArrayList<>();while(w.more()){int t=w.tag();if(t==8)id=w.varint();else if(t==34){Wire f=w.message();if(frames.size()<16)frames.add(frame(f));}else w.skip(t);}if(id!=wanted)throw invalid();StringBuilder out=new StringBuilder("Crashing thread frames (up to 16):\n");for(int i=0;i<frames.size();i++)out.append('#').append(i).append(' ').append(frames.get(i)).append('\n');if(frames.isEmpty())out.append("No frames retained.\n");return out.toString();}
+    private static String entry(Wire w,long tid)throws IOException {long key=0;Wire value=null;while(w.more()){int t=w.tag();if(t==8)key=w.varint();else if(t==18)value=w.message();else w.skip(t);}return key==tid&&value!=null?thread(value,tid):null;}
+    static String summarize(InputStream stream)throws IOException {
+        if(stream==null)return "Native trace unavailable (not retained).\n";
+        byte[] bytes; try(InputStream in=stream){ByteArrayOutputStream out=new ByteArrayOutputStream();byte[] buf=new byte[8192];int n;while((n=in.read(buf))!=-1){if(n==0||n>LIMIT-out.size())throw invalid();out.write(buf,0,n);}bytes=out.toByteArray();}
+        if(bytes.length==0)throw invalid(); Wire w=new Wire(bytes,0,bytes.length);long tid=0;String sig="Signal unavailable",abort="absent";List<String> causes=new ArrayList<>();boolean recognized=false;
+        while(w.more()){int t=w.tag();switch(t){case 48:tid=w.varint();break;case 82:sig=signal(w.message());recognized=true;break;case 114:abort=category(w.string());break;case 122:Wire cause=w.message();while(cause.more()){int ct=cause.tag();if(ct==10){String s=category(cause.string());if(causes.size()<4)causes.add(s);}else cause.skip(ct);}break;default:w.skip(t);}}
+        if(!recognized)throw invalid();String trace=null;w=new Wire(bytes,0,bytes.length);while(w.more()){int t=w.tag();if(t==130&&tid>0){String match=entry(w.message(),tid);if(match!=null){if(trace!=null)throw invalid();trace=match;}}else w.skip(t);}
+        return sig+"\nAbort category: "+abort+"\n"+(causes.isEmpty()?"":"Cause categories: "+String.join("; ",causes)+"\n")+(trace==null?"Crashing thread unavailable; no fallback guessed.\n":trace);
+    }
+}
